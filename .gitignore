# runtime data (flags db, service state) — never commit
**/data/
*.db
*.db-wal
*.db-shm
# native-run working dirs (run_local.py)
run/

# farm runtime + any real-platform configs (may hold your team token — don't commit)
farm/farm.log
farm/config.local.py
farm/config.prod.py

# defense runtime
defense/filter.log
*.pcap
# checkerwatch: identified checker ip + captured attacker requests (game-specific)
defense/checker.json
defense/live_exploits/

# python
**/__pycache__/
**/*.pyc
.venv/
venv/

# os / editor
.DS_Store
Thumbs.db

# deploy secrets / organizer artifacts — NEVER commit (token + WireGuard keys)
deploy/deploy.env
farm/config.prod.py
*.conf
deploy/wg-multi/conf/*
!deploy/wg-multi/conf/.gitkeep
