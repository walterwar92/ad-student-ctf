# ===== deploy/deploy.env — fill this, then `cp deploy.env.example deploy.env` =====
# Used by deploy/deploy.sh (runs from this PC, Git Bash) and the Windows dashboard.
# deploy.env itself is GITIGNORED (it points at your боевой server). Never commit it.

# --- team server (the organizers give you address + creds before the game) ---
SERVER_HOST=10.60.X.2          # or the public address the orgs hand you
SERVER_USER=root               # ssh user on the team server
SERVER_SSH_PORT=22
# Path to your ssh private key for that server (optional if you use an agent/password).
SERVER_SSH_KEY=~/.ssh/id_ed25519

# Where the project lives on the server (created by deploy.sh).
SERVER_DIR=/opt/ad-ctf

# Python on the server (3.9+). Leave as python3 unless it lives elsewhere.
SERVER_PYTHON=python3

# Farm dashboard port (matches gui.port in farm/config*.py). Viewed from this PC
# over an SSH tunnel, so it can stay bound to 127.0.0.1 on the server.
DASHBOARD_PORT=8070
