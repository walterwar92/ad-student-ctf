# ===== A&D Student CTF training range — configuration =====
# Number of team vulnboxes to spin up (team1 = YOU, team2..N = enemies you attack).
# Lower this (e.g. 4) on a laptop; raise up to 10 to match the final.
TEAMS=10

# Checker round length, in seconds. Each tick plants fresh flags into every service.
TICK_SECONDS=30

# How many ticks a flag stays valid for submission (older flags are "too old").
FLAG_LIFETIME_TICKS=5

# Which team is YOURS (the one you defend/patch). Its submit-token is derived below.
MY_TEAM=team1

# Host port for the scoreboard (http://127.0.0.1:<this>). 8080 is taken on this
# machine by "ApplicationWebServer", so we use 8090.
SCOREBOARD_PORT=8090

# Secret used to derive each team's flag-submission token. Keep it local.
GAME_SECRET=studentctf-local-dev-change-me
